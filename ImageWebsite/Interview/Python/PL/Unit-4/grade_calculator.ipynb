   "source": [
    "marks = float(input(\"Enter your marks: \"))\n",
    "if marks >= 90:\n",
    "    print(\"Grade: A\")\n",
    "elif marks >= 80:\n",
    "    print(\"Grade: B\")\n",
    "elif marks >= 70:\n",
    "    print(\"Grade: C\")\n",
    "elif marks >= 60:\n",
    "    print(\"Grade: D\")\n",
    "elif marks >= 40:\n",
    "    print(\"Grade: E\")\n",
    "else:\n",
    "    print(\"Grade: Fail\")"
   ]
  }
